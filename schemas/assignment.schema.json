{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "assignment",
  "$comment": "Portable contract v1. Runtime cross-file scope, hashing, fencing and time rules are additionally enforced by code.",
  "type": "object",
  "properties": {
    "contract": {
      "const": "file-ipc-portable/1"
    },
    "deployment_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "owner_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "role": {
      "enum": [
        "desktop",
        "broker"
      ]
    },
    "worker_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "assignment_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "issued": {
      "type": "number",
      "minimum": 0
    },
    "expires": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "enum": [
        "active",
        "closed"
      ]
    },
    "native_capability": {
      "enum": [
        "operator_attested",
        "not_required"
      ]
    }
  },
  "required": [
    "contract",
    "deployment_id",
    "run_id",
    "owner_id",
    "role",
    "worker_id",
    "assignment_id",
    "epoch",
    "issued",
    "expires",
    "status",
    "native_capability"
  ],
  "additionalProperties": false
}
